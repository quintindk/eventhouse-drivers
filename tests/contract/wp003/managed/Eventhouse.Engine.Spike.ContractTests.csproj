<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Eventhouse.Engine.Spike.ContractTests</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/engine/Eventhouse.Engine.Spike.csproj" />
    <None Include="../fixtures/*.json" CopyToOutputDirectory="PreserveNewest" Link="fixtures/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
